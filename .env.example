# ─── Zenith Secrets & Environment Configuration ──────────────────────
# Copy to .env and fill in. NEVER commit your actual .env file.
# Only GEMINI_API_KEY is required to start Zenith!

# Google AI Studio key (REQUIRED). Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── User Profile (Optional Defaults) ──────────────────────────────────
USER_NAME=Friend
USER_EMAIL=user@example.com
USER_TIMEZONE=UTC
USER_BIO=

# ── Gemini Live API (Bidirectional native audio streaming) ────────────
LIVE_VOICE_ENABLED=yes
LIVE_MODELS=gemini-3.1-flash-live-preview
# LIVE_SAMPLE_RATE=16000

# ── Fallback LLM Relay (Optional) ─────────────────────────────────────
# Used when primary quota limits are reached.
FALLBACK_API_KEY=
FALLBACK_ENDPOINT=https://api.deepseek.com/v1/chat/completions
FALLBACK_MODEL=deepseek-chat
FALLBACK_PREFER=no

# ── Voice: Speech-to-text (Groq Whisper) ──────────────────────────────
# Obtain key at https://console.groq.com/keys
GROQ_API_KEY=
STT_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# ── Voice: Text-to-speech (Edge Neural Voices) ────────────────────────
TTS_PROVIDER=edgetts
EDGE_VOICE=en-US-JennyNeural

# ── Voice Activity Detection (VAD) Tuning (ms) ────────────────────────
VOICE_SILENCE_MS=1300
VOICE_MIN_SPEECH_MS=250
VOICE_MAX_UTTERANCE_MS=20000

# ── Server & Ports ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8005
ZENITH_PORT=8005

# ── Execution Safeguards & Control Plane ──────────────────────────────
# Set to 'yes' if you want Zenith to be able to execute host shell commands
ALLOW_SHELL=no
ALLOW_DOCKER=yes
ALLOW_GITHUB=yes
ALLOW_SYSTEM=yes

# ── Email Gateway (Optional) ──────────────────────────────────────────
# Inbound IMAP (Gmail or standard IMAP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Outbound delivery via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Zenith <zenith@yourdomain.com>
RESEND_REPLY_TO=

# ── Google Calendar & Maps (Optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Google Maps API key (enables directions, commute times, and interactive embeds)
GOOGLE_MAPS_API_KEY=

# ── God's Eye View & Geospatial Intelligence (Optional) ────────────────
# Cesium Ion Access Token (https://ion.cesium.com/tokens)
CESIUM_ION_TOKEN=
# Enable God's Eye View 3D Globe simulator embeds in chat (yes/no)
GEV_ENABLED=yes
# Local Vite preview port for God's Eye View (default: 4173)
GEV_PORT=4173
# Optional public URL override for GEV embeds (e.g. https://gev.yourdomain.com)
GEV_PUBLIC_URL=
# OpenSky Network live flight tracking telemetry (https://opensky-network.org)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── GitHub Integration (Optional) ─────────────────────────────────────
# Personal Access Token with repo scope for PRs, issues, and code reviews
GH_TOKEN=
GITHUB_USER=

# ── Cloudflare & DNS Management (Optional) ────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=yourdomain.com

# ── Smart Home (Home Assistant) (Optional) ────────────────────────────
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=

# ── Media & Workflow Services (Optional) ──────────────────────────────
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
JELLYFIN_API_KEY=
N8N_URL=
N8N_API_KEY=
VERCEL_TOKEN=

# ── Sovereign Operating Layer & Sensors (Optional) ────────────────────
# Master kill-switch to pause all background sensing (yes/no)
GHOST_MODE=no
# Clippy Vision: proactive active window and workflow state tracking (yes/no)
CLIPPY_VISION_ENABLED=yes
# ActivityWatch: local private timeline of user workflows and productivity (yes/no)
ACTIVITY_WATCH_ENABLED=yes
# Mem0: multi-tier durable structured long-term memory layer (yes/no)
MEM0_ENABLED=yes
# Vision Engine: camera presence, QR scanning, and thumbs-up gesture approval (yes/no)
VISION_ENGINE_ENABLED=yes
WEBCAM_DEVICE_INDEX=0
# Autonomous Browser Use agent with safety checkpoints (yes/no)
BROWSER_USE_ENABLED=yes